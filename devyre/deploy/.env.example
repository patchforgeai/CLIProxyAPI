# Copy to .env next to this file (.env is gitignored). Forward slashes are fine on Windows.
# Runtime home mounted at /data: config.yaml, auths, logs, static, plugins, secrets.
CPA_HOME=C:/Users/Devyre/.cli-proxy-api
# Container time zone (IANA name).
CPA_TZ=America/Los_Angeles
# Tailnet URL, https://<machine>.<tailnet>.ts.net:8318 (tailscale-serve.ps1 prints it; it comes
# from `tailscale status --json` -> Self.DNSName). Keep the real hostname out of git: set it only
# in .env. up.ps1 prints it. The PowerShell profile reads it from
# %USERPROFILE%\.cli-proxy-api-client\public-url.txt instead (new-secrets.ps1 -PublicUrl), which
# is outside CPA_HOME so the container cannot change where clients send requests.
CPA_PUBLIC_URL=
